{
  "name": "Psilocybin EEG – Issue Sandbox",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "remoteUser": "researcher",
  // workspaceMount = the worktree directory only (e.g. .worktrees/issue-N/)
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "mounts": [
    // ${localWorkspaceFolder}/../../ reaches the main repo root when opened from
    // a worktree two levels deep (e.g. .worktrees/issue-N/).
    // When opening from the repo root directly, adjust these paths accordingly.
    "source=${localWorkspaceFolder}/../../data,target=/data,type=bind",
    "source=${localWorkspaceFolder}/../../plots,target=/plots,type=bind",
    "source=${localWorkspaceFolder}/../../results,target=/results,type=bind",
    "source=${localWorkspaceFolder}/../../results_db,target=/results_db,type=bind",
    "source=psilocybin-claude-config,target=/home/researcher/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/researcher/.claude",
    "PSILOCYBIN_DATA_DIR": "/data",
    "PSILOCYBIN_RESULTS_DIR": "/results",
    "MPLBACKEND": "Agg"
  },
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && pip install -e /workspace --quiet",
  "waitFor": "postStartCommand"
}
