    "            }\n",
    "        ),\n",
    "    ]\n",
    ")\n",
    "df_subj = pd.concat(\n",
    "    [\n",
    "        pd.DataFrame(\n",
    "            {\n",
    "                \"subject\": np.arange(n_subjects),\n",
    "                \"mean_isc\": loo_pearson.mean(axis=1),\n",
    "                \"method\": \"Pearson\",\n",
    "            }\n",
