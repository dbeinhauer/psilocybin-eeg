#!/bin/bash
#PBS -N PSILO_CORRCA_06B_BAND_SWAP
#PBS -l walltime=3:00:00
#PBS -l select=1:ncpus=2:mem=100gb:scratch_local=100gb
#PBS -m ae
#PBS -j oe

# ===========================================================================
# run_band_swap.pbs
#   Band-swapped CorrCA filters: broadband <-> 30-50 Hz and 1-30 Hz. READ-ONLY.
#   Stage 06b
#
# USAGE   (bash run_band_swap.pbs --help prints this block)
#   qsub run_band_swap.pbs
#       the tracks run at N_PCA=5, both bands, TF maps and SNR grid
#   qsub -v RUNS=separate,N_PCA=10 run_band_swap.pbs
#       another run and component count
#   qsub -v RUNS="tracks separate placebo_fit" -l walltime=5:00:00 run_band_swap.pbs
#       several runs (about 1.5 h each)
#   qsub -v BANDS=1-30hz,STEPS=tf run_band_swap.pbs
#       one band, the TF maps only
#
# PARAMETERS   (qsub -v NAME=value,NAME2="a b"; the defaults in brackets)
#   RUNS           [tracks]  which runs, any of: tracks (time-axis join),
#                            separate (subject-axis join), placebo_fit (separate,
#                            filters fitted on Placebo), individual (each condition
#                            alone)
#   N_PCA          [5]       the component count of the stores read
#   BANDS          [30-50hz 1-30hz]  the band twins each broadband store is swapped with
#   STEPS          [tf snr]  tf: the TF maps; snr: the SNR grid of the same reading
# END USAGE
#
# WHAT IT DOES
#
# Each selected run is read on its FULL fit only (full montage, raw power); the
# '_log', '_roi', '_non_roi' fits are never read here.
#
#   1. tf: scripts/run_corrca_band_swap.py pairs the broadband store with its
#      band twin (same run and N_PCA) and reads each fit through the other's
#      filters, input z-scored along time per (channel, frequency) and
#      condition. The band fit's filters on the broadband input (every
#      frequency, 1-50 Hz) go into the BROADBAND fit's directory, the band's
#      inner edge (30 Hz) marked beside the 40 Hz line: for 1-30hz this is the
#      main reading, whether a topography chosen below 30 Hz also carries the
#      40 Hz response. The broadband filters on the band input go into the BAND
#      fit's directory. TF maps of CC 1-3 (whole recording, stimulus average,
#      participants/) and the topomap / filter r of every component.
#
#   2. snr: scripts/run_corrca_snr_grid.py --swap_band <band>: the broadband
#      store read through its band twin's filters at 40 Hz (0 and +-5 Hz,
#      windows 0-0.5 s and 0.2-0.5 s) against the store's usual ASSR
#      references, with the stage-06 tests. Its own result files, so the
#      store's grid is never overwritten.
#
# Needs, for each run at N_PCA, the broadband store and its band twins (the
# run's fit job and its _gamma and _1_30hz twins). A missing store skips only
# its pair.
#
# OUTPUT
#   plots/06b-corrca-condition-comparison/<Join>_ASSR/broadband/<variant>/pca_<N>/
#       band_swapped_filter_<band>_condition_mean_tf_maps{,_onset}.png,
#       band_swapped_filter_<band>_topomap_correlation.csv, participants/
#       snr_grid/<selection>/<window>/*__band_swapped_filter_<band>.png
#   plots/06b-corrca-condition-comparison/<Join>_ASSR/bands/<variant>/pca_<N>/
#       <band>_band_swapped_filter_*        (the other way round)
#   results/assr/corrca_band_swap__<variant>__<band>__pca<N>.csv
#   results/assr/corrca_band_swap_snr__<variant>__<band>__pca<N>{.csv,__courses.npz,__values.npz}
#
# RESOURCES
#   One participant's broadband block (~2.4 GB float32) plus its z-scored copy
#   and the float64 upcast of a projection, beside the CC 1-3 projections of
#   the pair, well below mem=100gb (kept as sized for all six pairs of a run).
#   Walltime 3 h: about 1.5 h per run (both bands, both steps). numpy z-scoring
#   is single-threaded; the projections use BLAS (2 threads).
# ===========================================================================

# --help: print the USAGE block above and exit, without submitting or running
# anything (bash <this job>.pbs --help).
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    sed -n '/^# USAGE/,/^# END USAGE/{/^# END USAGE/d;s/^# \{0,1\}//;p}' "$0"
    exit 0
fi

set -e

cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music_new.sif"

export TMPDIR=$SCRATCHDIR
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

N_PCA="${N_PCA:-5}"
RUNS="${RUNS:-tracks}"
BANDS="${BANDS:-30-50hz 1-30hz}"
STEPS="${STEPS:-tf snr}"
echo "runs: $RUNS, PCA dimensions: $N_PCA, bands: $BANDS, steps: $STEPS"

# The runner heredoc below is quoted, so these are read from the container
# environment at run time rather than substituted here.
export SINGULARITYENV_N_PCA="$N_PCA" APPTAINERENV_N_PCA="$N_PCA"
export SINGULARITYENV_BANDS="$BANDS" APPTAINERENV_BANDS="$BANDS"
export SINGULARITYENV_STEPS="$STEPS" APPTAINERENV_STEPS="$STEPS"
export SINGULARITYENV_RUNS="$RUNS" APPTAINERENV_RUNS="$RUNS"

cat << 'EOF' > run_inside.sh
#!/bin/bash
set -e
source /opt/myproject/.venv/bin/activate

DATA_DIR="/mnt/data/processed"

# RUNS -> store variants. No --log_power / --roi_fit / --non_roi_fit is ever
# passed, so each run is read on its full fit alone.
VARIANTS=""
for RUN in ${RUNS:-tracks}; do
    case "$RUN" in
        separate)    VARIANTS+=" corrca_channel_joined_separate" ;;
        tracks)      VARIANTS+=" corrca_channel_joined_tracks" ;;
        placebo_fit) VARIANTS+=" corrca_channel_placebo_fit" ;;
        individual)  VARIANTS+=" corrca_channel_individual_conditions" ;;
        *) echo >&2 "unknown RUNS entry: $RUN"; exit 1 ;;
    esac
done

if [[ " ${STEPS:-tf snr} " == *" tf "* ]]; then
for BAND in ${BANDS:-30-50hz 1-30hz}; do
for VARIANT in $VARIANTS; do
    echo "=== band swap: $VARIANT, $BAND at $(date) ==="
    python /mnt/scripts/run_corrca_band_swap.py \
        --experiment assr \
        --variant "$VARIANT" \
        --music_type ASSR \
        --band "$BAND" \
        --conditions Placebo Psilocybin \
        --n_pca "${N_PCA:-5}" \
        --swapped_components 3 \
        --store_dir "$DATA_DIR" \
        --wavelet_data_dir "$DATA_DIR" \
        --results_dir /mnt/results/assr \
        --save_dir /mnt/plots
done
done
fi

if [[ " ${STEPS:-tf snr} " == *" snr "* ]]; then
for BAND in ${BANDS:-30-50hz 1-30hz}; do
for VARIANT in $VARIANTS; do
    echo "=== band-swap SNR grid: $VARIANT, $BAND at $(date) ==="
    python /mnt/scripts/run_corrca_snr_grid.py \
        --experiment assr \
        --variant "$VARIANT" \
        --music_type ASSR \
        --swap_band "$BAND" \
        --conditions Placebo Psilocybin \
        --n_pca "${N_PCA:-5}" \
        --halfwidths 0 5 \
        --stimulus_intervals 0:0.5 0.2:0.5 \
        --contrast_alternative greater \
        --snr_alternative less \
        --store_dir "$DATA_DIR" \
        --wavelet_data_dir "$DATA_DIR" \
        --results_dir /mnt/results/assr \
        --save_dir /mnt/plots
done
done
fi
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
