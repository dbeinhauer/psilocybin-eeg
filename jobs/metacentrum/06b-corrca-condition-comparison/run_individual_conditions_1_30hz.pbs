#!/bin/bash
#PBS -N PSILO_CORRCA_INDIVIDUAL_06B_1_30HZ
#PBS -l walltime=4:00:00
#PBS -l select=1:ncpus=4:mem=300gb:scratch_local=100gb
#PBS -m ae
#PBS -j oe

# ---------------------------------------------------------------------------
# DEFAULT: only the full montage on raw power is fitted, and only its stored
# sources ('full') are read by the grid. qsub -v FITS="<any of: log_power roi_fit
# non_roi_fit roi_masked>" adds the log-power twins, the ROI / non-ROI cuts, the
# masked readings (roi_masked, non_roi_masked) and, with log_power, the
# swapped_filter rows. The fits and memory below describe every fit selected;
# the full fit alone needs the raw tensor plus one full-montage fit.
#
# RESOURCES: memory and CPUs as for every fit (mem=300gb, ncpus=4,
# --parallel_fits 3), so any FITS selection fits; only the walltime is sized for
# the default full fit (4:00:00). With FITS, request the old walltime too: qsub
# -l walltime=6:00:00. PARALLEL_FITS (default 3) sets how many fits run at once.
#
# Stage-06b CorrCA — each condition ALONE (Placebo only, then Psilocybin
# only).
#
# 1. FIT: scripts/run_corrca_individual_conditions.py — the JOINED_TRACKS fit
#    reduced to one track, run once per condition. Every participant the
#    condition has is one subject; CorrCA fits that condition its OWN channel
#    filters, so 'CC 1' of Placebo and 'CC 1' of Psilocybin are different spatial
#    combinations, compared by topography and synchrony, not row by row. No
#    paired ISC test. Sign: one per component, from the shared pattern against
#    the ASSR electrode mask.
#
#    Six fits from the ONE loaded tensor, in this order:
#      1. full montage                    2. full montage on log power ('_log')
#      3. ASSR ROI alone ('_roi')         4. every other electrode ('_non_roi')
#      5. '_log_roi'                      6. '_log_non_roi'
#    Each cut is made BEFORE the z-scoring (ROI -> z-score -> PCA -> CorrCA). The
#    log-power fits take log10 of the power (floored at the dtype's smallest
#    normal number) BEFORE any z-scoring. Both full-montage fits also draw their
#    filter read through the ROI alone (roi_masked_*) and through the rest of the
#    head (non_roi_masked_*). Only the ones FITS selects (see the top).
#    The fits run in parallel, each in its own forked process reading the one
#    loaded tensor; --parallel_fits caps how many at once (see MEMORY).
#
#    A fit whose store for this N_PCA already exists is READ BACK, not refit
#    (--skip_stored), and every figure is still drawn from it; the data is
#    loaded either way, for the masked maps and any missing fit. A store
#    fitted on other data is refused. qsub -v FORCE_FIT=1 refits all six.
#
# 1-30 HZ BAND (everything below gamma): the frequency axis is cut to 1-30 Hz
# (--band_range 1 30) BEFORE the fit, so the filter is chosen on delta-beta
# samples only, the counterpart of the 30-50 Hz (_gamma) run. Stored and plotted
# under the band token '1-30hz' (plots under bands/, a '1-30hz_' prefix), beside
# the broadband and 30-50 Hz runs rather than over either.
#
# FIT ONLY: no SNR grid. The grid reads its 'full' rows at 40 Hz on the store's
# own bins, which a 1-30 Hz store does not have (it refuses such a store). Whether
# these filters carry the 40 Hz response is read by run_band_swap.pbs instead:
# the 1-30 Hz filters applied to the broadband input, at every frequency
# (band_swapped_filter_1-30hz_* in the broadband fit's directory). Submit it
# after this job (qsub -v BANDS=1-30hz run_band_swap.pbs).
#
# qsub -v N_PCA=10 fits another component count (default 5).
#
# Output:
#   plots/06b-corrca-condition-comparison/IndividualConditions_ASSR/bands/
#       corrca_channel_individual_conditions/<Condition>/pca_<N>/   # + _log, _roi, _non_roi,
#                                         _log_roi, _log_non_roi
#           condition_mean_*, participants/, corrca_*,
#           roi_masked_*, non_roi_masked_*,            # fit
#   data/processed/assr/iva_results/<Condition>/
#       corrca_channel_individual_conditions{,_log,_roi,_non_roi,_log_roi,_log_non_roi}__ASSR__1-30hz__pca<N>.npz
#
# MEMORY (499 GB is the hard cap). The band is cut after loading, so the load is
# the broadband one (one condition's broadband tensor, ~29 GB, stays beside the
# ~17 GB 1-30 Hz cut: 30 of the 50 bins). Each running fit holds about three
# copies of its prepared input at its peak — a full-montage 1-30 Hz fit ~52 GB —
# and --parallel_fits 3 lets three full-montage fits' worth run at once (cut fits
# count as their share of the channels: ROI ~0.2, non-ROI ~0.8), so ~200 GB. The
# conditions run one after the other, hence the walltime. Check
# resources_used.mem after a run.
# ---------------------------------------------------------------------------

set -e

cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music_new.sif"

export TMPDIR=$SCRATCHDIR
# Up to four fits run at once (--parallel_fits), one BLAS thread each: one per CPU.
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

N_PCA="${N_PCA:-5}"
FORCE_FIT="${FORCE_FIT:-0}"
echo "PCA dimensions: $N_PCA, force fit: $FORCE_FIT"

# The runner heredoc below is quoted, so these are read from the container
# environment at run time rather than substituted here.
export SINGULARITYENV_N_PCA="$N_PCA" APPTAINERENV_N_PCA="$N_PCA"
export SINGULARITYENV_FORCE_FIT="$FORCE_FIT" APPTAINERENV_FORCE_FIT="$FORCE_FIT"
FITS="${FITS:-}"
echo "opt-in fits and readings: ${FITS:-none}"
export SINGULARITYENV_FITS="$FITS" APPTAINERENV_FITS="$FITS"
PARALLEL_FITS="${PARALLEL_FITS:-3}"
echo "fits at once: $PARALLEL_FITS"
export SINGULARITYENV_PARALLEL_FITS="$PARALLEL_FITS" APPTAINERENV_PARALLEL_FITS="$PARALLEL_FITS"

cat << 'EOF' > run_inside.sh
#!/bin/bash
set -e
source /opt/myproject/.venv/bin/activate

DATA_DIR="/mnt/data/processed"

# Opt-in fits and readings (FITS); the full montage on raw power always runs.
FIT_FLAGS=()
MASKED_FLAG=()
SIGNALS=(full)
for F in ${FITS:-}; do
    case "$F" in
        log_power) FIT_FLAGS+=(--log_power); SIGNALS+=(swapped_filter) ;;
        roi_fit|non_roi_fit) FIT_FLAGS+=("--$F") ;;
        roi_masked) MASKED_FLAG=(--roi_masked); SIGNALS+=(roi_masked non_roi_masked) ;;
        *) echo >&2 "unknown FITS entry: $F"; exit 1 ;;
    esac
done
MASKED_TF=()
if [ "${#SIGNALS[@]}" -gt 1 ]; then
    MASKED_TF=(--masked_tf_maps)
fi

SKIP_STORED=(--skip_stored)
if [ "${FORCE_FIT:-0}" = "1" ]; then
    SKIP_STORED=()
fi

echo "=== fit at $(date) ==="
python /mnt/scripts/run_corrca_individual_conditions.py \
    --experiment assr \
    --conditions Placebo Psilocybin \
    --n_pca "${N_PCA:-5}" \
    --gamma 0.0 \
    --band_range 1 30 \
    --wavelet_data_dir "$DATA_DIR" \
    --reuse_wavelets \
    --store_components \
    --store_dir "$DATA_DIR" \
    "${SKIP_STORED[@]}" \
    --save_dir /mnt/plots \
    --n_jobs -1 \
    --parallel_fits "${PARALLEL_FITS:-3}" \
    "${FIT_FLAGS[@]}" "${MASKED_FLAG[@]}"
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
