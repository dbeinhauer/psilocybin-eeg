#!/bin/bash
#PBS -N PSILO_CORRCA_06B_COMPARISON
#PBS -l walltime=2:00:00
#PBS -l select=1:ncpus=1:mem=16gb:scratch_local=1gb
#PBS -m ae
#PBS -j oe

# ===========================================================================
# run_comparison.pbs
#   CorrCA fits side by side across n_pca, bands or methods. READ-ONLY.
#   Stage 06b; notebooks corrca_comparison_{pca,band,join}.ipynb
#
# USAGE   (bash run_comparison.pbs --help prints this block)
#   qsub run_comparison.pbs
#       all three comparisons with the defaults below
#   qsub -v COMPARE=pca,RUN=separate,PCAS="3 5 10 20 30" run_comparison.pbs
#       one run across component counts
#   qsub -v COMPARE=band,RUNS="tracks placebo_fit",N_PCA=10 run_comparison.pbs
#       each run across broadband / 1-30 Hz / 30-50 Hz
#   qsub -v COMPARE=join,RUNS="tracks separate placebo_fit individual" run_comparison.pbs
#       the methods against each other
#   qsub -v COMPARE=join,JOIN_BANDS="broadband 30-50hz" run_comparison.pbs
#       the methods, once per band
#
# PARAMETERS   (qsub -v NAME=value,NAME2="a b"; the defaults in brackets)
#   COMPARE        [pca band join]  which comparisons, one call each:
#                    pca   RUN at every PCAS (broadband)
#                    band  each of RUNS at N_PCA: broadband, 1-30hz, 30-50hz
#                    join  RUNS against each other at N_PCA, per JOIN_BANDS band
#   RUN            [tracks]   the run of the pca comparison
#   PCAS           [3 5 10 20]  the component counts of the pca comparison
#   RUNS           [tracks separate placebo_fit psilocybin_fit]  the runs of band
#                    and join, any of tracks, separate, placebo_fit,
#                    psilocybin_fit, individual; in join the first
#                    is the topomaps' reference row
#   N_PCA          [5]        the component count of band and join
#   JOIN_BANDS     [broadband]  the band(s) join runs in: broadband, 30-50hz, 1-30hz
# END USAGE
#
# WHAT IT DOES
#
# scripts/run_corrca_comparison.py reads the FULL fit (full montage, raw power)
# of each compared run and compares CC 1-3 by index (never re-matched):
#   - ISC: the fit's own (in-sample), per condition on the whole recording and on
#     the onset-locked maps
#   - held out: median held-out ISC, in-sample - held-out gap, topography |r| of
#     the leave-one-participant-out refits (median, worst)
#   - Placebo vs Psilocybin p (uncorrected): LOO-ISC whole and onset, SNR contrast
#     at 40 Hz in 0-0.5 s and 0.2-0.5 s, the R_w and R_b terms
#   - SNR courses per condition; shared filters and forward patterns as topomaps
#   - condition-mean TF maps, whole recording and onset-locked: each fit's
#     Placebo row above its Psilocybin row, the next fit's pair below
#   - the two terms of each ISC (R_w: the component's variance, R_b: its
#     covariance with the others) per condition and participant, from the stored
#     sources, and how both move with a participant left out (influence CSV)
#
# Needs the fit jobs (run_condition_*, run_placebo_fit*, run_psilocybin_fit*,
# run_individual_conditions*) at those N_PCA, with their SNR grids. A missing
# store, CSV or grid is a warning and a gap in the figures, never an error. A
# 1-30 Hz fit has no 40 Hz bin: its SNR rows are its filters on the broadband
# input, from run_band_swap.pbs (run it first, with the same RUNS and N_PCA). A
# fit whose influence CSV predates the R_w / R_b columns has no shift figure
# (rerun its fit job).
#
# OUTPUT
#   plots/06b-corrca-condition-comparison/Comparison_ASSR/
#       broadband/pca__<variant>/                     pca
#       band__<variant>/pca_<N>/                      band, one per run
#       {broadband,bands}/join__<RUNS joined by ->/pca_<N>/   join ('<band>_' prefix)
#           corrca_comparison_{metrics,topomap_filter,topomap_pattern,
#                              tf_maps,tf_maps_onset,snr_course,
#                              variance_terms,variance_shift}.png
#           corrca_comparison_metrics.csv, _variance_terms{,_tests}.csv,
#           _variance_shift.csv
#
# RESOURCES
#   One store at a time, only CC 1-3 kept, streamed one recording at a time.
#   The per-condition TF maps (float64 copies of each condition's maps) set the
#   peak: 4.5 GB measured for a 10-component broadband join, beside the file
#   cache of streaming multi-GB stores, which the cgroup counts too; mem=16gb
#   leaves room for both (8gb hit 'Cgroup memsw limit exceeded'). ~1-2 min per
#   broadband store. Single-threaded numpy.
# ===========================================================================

# --help: print the USAGE block above and exit, without submitting or running
# anything (bash <this job>.pbs --help).
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    sed -n '/^# USAGE/,/^# END USAGE/{/^# END USAGE/d;s/^# \{0,1\}//;p}' "$0"
    exit 0
fi

set -e

cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music_new.sif"

export TMPDIR=$SCRATCHDIR
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

RUN="${RUN:-tracks}"
PCAS="${PCAS:-3 5 10 20}"
N_PCA="${N_PCA:-5}"
COMPARE="${COMPARE:-pca band join}"
RUNS="${RUNS:-tracks separate placebo_fit psilocybin_fit}"
JOIN_BANDS="${JOIN_BANDS:-broadband}"
echo "run: $RUN, n_pca sweep: $PCAS, n_pca: $N_PCA, comparisons: $COMPARE," \
     "runs: $RUNS, join bands: $JOIN_BANDS"

# The runner heredoc below is quoted, so these are read from the container
# environment at run time rather than substituted here.
for VAR in RUN PCAS N_PCA COMPARE RUNS JOIN_BANDS; do
  export "SINGULARITYENV_$VAR=${!VAR}" "APPTAINERENV_$VAR=${!VAR}"
done

cat << 'EOF' > run_inside.sh
#!/bin/bash
set -e
source /opt/myproject/.venv/bin/activate

DATA_DIR="/mnt/data/processed"
COMMON=(
    --experiment assr
    --music_type ASSR
    --conditions Placebo Psilocybin
    --components 3
    --snr_selection 40hz
    --snr_windows 0-0.5s 0.2-0.5s
    --store_dir "$DATA_DIR"
    --fit_plots_dir /mnt/plots
    --results_dir /mnt/results/assr
    --save_dir /mnt/plots
)

# One failing comparison must not stop the others: each runs, and the job exits 1
# at the end if any failed.
FAILED=0
compare() {
    python /mnt/scripts/run_corrca_comparison.py "$@" "${COMMON[@]}" || {
        echo >&2 "FAILED: run_corrca_comparison.py $*"
        FAILED=1
    }
}

for MODE in $COMPARE; do
    echo "=== comparison: $MODE at $(date) ==="
    case "$MODE" in
        pca)  compare --compare pca --run "$RUN" --n_pca $PCAS ;;
        band) for ONE in $RUNS; do
                  compare --compare band --run "$ONE" --n_pca "$N_PCA"
              done ;;
        join) for BAND in $JOIN_BANDS; do
                  compare --compare join --runs $RUNS --band "$BAND" --n_pca "$N_PCA"
              done ;;
        *) echo >&2 "unknown comparison $MODE"; exit 1 ;;
    esac
done
exit "$FAILED"
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed (see FAILED lines above)"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
