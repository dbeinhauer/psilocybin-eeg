#!/bin/bash
#PBS -N PSILO_CORRCA_JOINED_06B_BAND
#PBS -l walltime=2:00:00
#PBS -l select=1:ncpus=4:mem=200gb:scratch_local=80gb
#PBS -m ae
#PBS -j oe

# ---------------------------------------------------------------------------
# Stage-06b CorrCA — condition comparison on the JOINED_SEPARATE condition.
#
# Runs scripts/run_corrca_condition_comparison.py (the same code as
# notebooks/06b-corrca-condition-comparison/corrca_channel_joined_separate.ipynb)
# on full data. Placebo and Psilocybin are pooled on the SUBJECT axis (2P
# recordings); Correlated Component Analysis fits ONE channel filter per
# component, shared by every recording, maximising the inter-recording
# correlation of the projected wavelet power (samples = time × frequency).
# --n_pca is the dimension of the pooled covariance subspace = component count.
#
# GAMMA BAND: the frequency axis is cut to 30-50 Hz (--band_range 30 50) BEFORE
# the fit, so the filter is chosen on gamma-band samples only and the 40 Hz
# steady state is not blended with the low-frequency onset response. Stored and
# plotted under the band token '30-50hz' (plots under bands/), beside the
# broadband run rather than over it.
#
# Sign: one per component, from the shared pattern against the ASSR electrode
# mask (never per recording — the filter is shared).
#
# Plots (panels "CC <k>"):
#   - condition_mean_topomaps / condition_mean_tf_maps / ..._onset
#   - participants/*                    per component, one column per participant
#   - corrca_shared_topomaps            the model's group topography
#   - corrca_condition_isc (+ 3 CSVs)   ISC per condition from the same filters,
#                                       paired LOO-ISC + Wilcoxon (uncorrected)
#
# ROI FIT. Every run also fits a second time on the binary ASSR ROI alone
# (ROI -> z-score -> PCA -> CorrCA), from the same loaded tensor, stored and drawn
# as the '_roi' variant beside the full-montage one; the full fit also draws
# 'roi_masked_*' TF maps (its filter restricted to the ROI). --skip_roi_fit /
# --skip_roi_masked drop them. Walltime allows for the second fit and figure set.
#
# Output:
#   plots/06b-corrca-condition-comparison/JoinedSeparate_ASSR/
#       bands/corrca_channel_joined_separate/pca_<N>/
#   data/processed/assr/iva_results/JoinedSeparate/
#       corrca_channel_joined_separate__ASSR__30-50hz__pca<N>.npz
#
# MEMORY. Same shape as the stage-06 IVA job: the pooled tensor and its z-scored
# copy dominate (upper bound ~230 GB for the full ASSR extent); CorrCA itself
# adds only one (channels × freqs·times) float64 accumulator. Do not reduce mem
# without also setting --n_times. The fit is a few covariance passes and one
# eigendecomposition, so it is far faster than IVA-G; loading dominates the time.
# BLAS threads are pinned to the requested cores below.
# ---------------------------------------------------------------------------

set -e

cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music_new.sif"

export TMPDIR=$SCRATCHDIR
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

cat << 'EOF' > run_inside.sh
#!/bin/bash
source /opt/myproject/.venv/bin/activate

WAVELET_DIR="/mnt/data/processed"
STORE_DIR="/mnt/data/processed"

COMMON_ARGS=(
    --experiment assr
    --conditions Placebo Psilocybin
    --gamma 0.0
    --wavelet_data_dir "$WAVELET_DIR"
    --reuse_wavelets
    --store_components
    --store_dir "$STORE_DIR"
    --n_jobs -1
)

echo "=== 30-50 Hz at $(date) ==="
python /mnt/scripts/run_corrca_condition_comparison.py \
    --n_pca 5 \
    --band_range 30 50 \
    "${COMMON_ARGS[@]}"

EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
