#!/bin/bash
#PBS -N PSILO_CORRCA_SNR_TRACKS_06B
#PBS -l walltime=1:00:00
#PBS -l select=1:ncpus=4:mem=200gb:scratch_local=100gb
#PBS -m ae
#PBS -j oe

# ---------------------------------------------------------------------------
# Stage-06b — full-recording ASSR SNR / condition-contrast GRID for the stored
# CorrCA time-axis (JoinedTracks) run (scripts/run_corrca_snr_grid.py).
#
# The CorrCA companion of
# jobs/metacentrum/06-iva-condition-comparison/run_snr_grid_tracks.pbs: same
# trials, references, test families and figures. The stored sources are unsplit
# (both conditions on one time axis); the grid slices each condition's segment
# back out before cutting trials on that condition's own onsets. One shared
# filter, so no per-recording polarity flip.
#
# PREREQUISITE: run_condition_tracks.pbs (this stage) with --store_components at
# the same --n_pca, over the FULL channel set.
#
# ROI STORE. The grid then reads the join's '_roi' store (the fit job's second,
# ROI-only decomposition) the same way: CSV assr_snr_grid__<variant>_roi__*.csv,
# figures under corrca_snr_grid_roi/. A missing ROI store is skipped with a
# warning; --skip_roi skips it. Walltime allows for the second pass over the cache.
#
# MASKED VARIANTS. roi_masked reads CC filters on the ASSR electrodes only,
# non_roi_masked on every other electrode; the two add up to the full filter.
# --masked_tf_maps also stores their full trial-normalised TF maps, which
# reads the cache at all 50 bins instead of the 11 around 40 Hz (the reason
# for the longer walltime). The ROI store has no non-ROI electrode and skips
# non_roi_masked.
#
# Output:
#   results/assr/assr_snr_grid__corrca_channel_joined_tracks__broadband__pca5.csv
#   results/assr/assr_snr_grid__corrca_channel_joined_tracks__broadband__pca5__values.npz
#   results/assr/assr_snr_grid__corrca_channel_joined_tracks__broadband__pca5__courses.npz
#   results/assr/assr_snr_grid__corrca_channel_joined_tracks__broadband__pca5__tf_baseline.npz
#   plots/06b-corrca-condition-comparison/JoinedTracks_ASSR/broadband/
#       corrca_snr_grid/pca_5/masked_filter_topomaps.png
#       corrca_snr_grid/pca_5/non_roi_masked_filter_topomaps.png
#       corrca_snr_grid/pca_5/tf_baseline_maps.png   # trial-normalised, baseline SD
#       corrca_snr_grid/pca_5/tf_baseline_maps__{roi_masked,non_roi_masked}.png
#       corrca_snr_grid/pca_5/<selection>/<window>/*.png
# -------------------------------------------------------------------

set -e

cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music_new.sif"

export TMPDIR=$SCRATCHDIR
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

# qsub -v N_PCA=5 ... reads another stored fit.
N_PCA="${N_PCA:-20}"
echo "PCA dimensions: $N_PCA"

# The runner heredoc below is quoted, so this is read from the container
# environment at run time rather than substituted here.
export SINGULARITYENV_N_PCA="$N_PCA"
export APPTAINERENV_N_PCA="$N_PCA"

cat << 'EOF' > run_inside.sh
#!/bin/bash
source /opt/myproject/.venv/bin/activate

DATA_DIR="/mnt/data/processed"

python /mnt/scripts/run_corrca_snr_grid.py \
    --experiment assr \
    --variant corrca_channel_joined_tracks \
    --music_type ASSR \
    --conditions Placebo Psilocybin \
    --n_pca "${N_PCA:-20}" \
    --halfwidths 0 5 \
    --stimulus_intervals 0:0.5 0.2:0.5 \
    --signal_variants full roi_masked non_roi_masked \
    --masked_tf_maps \
    --contrast_alternative greater \
    --snr_alternative less \
    --store_dir "$DATA_DIR" \
    --wavelet_data_dir "$DATA_DIR" \
    --results_dir /mnt/results/assr \
    --save_dir /mnt/plots
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

singularity exec -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
