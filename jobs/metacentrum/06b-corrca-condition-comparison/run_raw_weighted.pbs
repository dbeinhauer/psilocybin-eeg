#!/bin/bash
#PBS -N PSILO_CORRCA_06B_RAW_WEIGHTED
#PBS -l walltime=2:00:00
#PBS -l select=1:ncpus=1:mem=8gb:scratch_local=1gb
#PBS -m ae
#PBS -j oe

# ===========================================================================
# run_raw_weighted.pbs
#   Raw voltages weighted by the CorrCA topographies, read as PC1 and as the mean
#   over all electrodes. READ-ONLY. Stage 06b; notebook corrca_raw_weighted.ipynb
#
# USAGE   (bash run_raw_weighted.pbs --help prints this block)
#   qsub run_raw_weighted.pbs
#       the tracks run at N_PCA=5, broadband and 30-50 Hz
#   qsub -v RUNS="tracks separate individual" run_raw_weighted.pbs
#       several runs, sharing one y-scale
#   qsub -v N_PCA=10,BANDS=broadband run_raw_weighted.pbs
#       another component count, broadband only
#
# PARAMETERS   (qsub -v NAME=value,NAME2="a b"; the defaults in brackets)
#   RUNS           [tracks]  which runs, any of: tracks (time-axis join),
#                            separate (subject-axis join), placebo_fit (separate,
#                            filters fitted on Placebo), individual (each condition
#                            alone)
#   N_PCA          [5]       the component count of the stores read
#   BANDS          [broadband 30-50hz]  store bands read (broadband, 30-50hz, 1-30hz)
#   FITS           [none]    also read the runs' other fits, any of: log_power,
#                            roi_fit, non_roi_fit, roi_masked (as the fit jobs'
#                            FITS made them; see run_condition_tracks.pbs --help)
# END USAGE
#
# WHAT IT DOES
#
# scripts/run_corrca_raw_weighted.py, per recording: z-score the RAW
# concatenated voltage per channel, cut at every fam+ onset, multiply every
# electrode by its weight (|CC 1|, |CC 2| and |CC 3| shared topography of each
# fit read, the binary ASSR ROI, or uniform = the stage-00 reference). Two
# readouts, each trial minus its pre-onset mean over the pre-onset SD pooled
# over trials, then the trial mean: pc1 (the PCA of the weighted trial mean,
# stage 00's, every trial on PC1, sign aligned across every recording of both
# conditions) and mean (over all electrodes, no component separated). Every run
# read goes into ONE call, so all its figures share one y-range for the curves
# and one for the differences. A missing store skips only itself.
#
# OUTPUT   (in each fit's own directory; <r> = pc1 or mean)
#   plots/06b-corrca-condition-comparison/<Join>_ASSR/{broadband,bands}/<variant>/pca_<N>/
#       raw_weighted/[<band>_]raw_weighted_<r>.png              rows = conditions
#       raw_weighted/[<band>_]raw_weighted_<r>_overlay.png      uniform vs each
#       raw_weighted/[<band>_]raw_weighted_<r>_differences.png
#       raw_weighted/participants/[<band>_]raw_weighted_<r>_{cc1,cc2,cc3,roi,uniform}.png
#
# RESOURCES
#   One recording at a time: its raw voltage and z-scored copy (195 x 46980
#   float64, ~75 MB each) plus its trials (~70 MB); every store's curves are a
#   few MB. Single-threaded numpy.
# ===========================================================================

# --help: print the USAGE block above and exit, without submitting or running
# anything (bash <this job>.pbs --help).
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    sed -n '/^# USAGE/,/^# END USAGE/{/^# END USAGE/d;s/^# \{0,1\}//;p}' "$0"
    exit 0
fi

set -e

cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music_new.sif"

export TMPDIR=$SCRATCHDIR
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

N_PCA="${N_PCA:-5}"
RUNS="${RUNS:-tracks}"
BANDS="${BANDS:-broadband 30-50hz}"
echo "runs: $RUNS, PCA dimensions: $N_PCA, bands: $BANDS"

# The runner heredoc below is quoted, so this is read from the container
# environment at run time rather than substituted here.
export SINGULARITYENV_N_PCA="$N_PCA" APPTAINERENV_N_PCA="$N_PCA"
export SINGULARITYENV_RUNS="$RUNS" APPTAINERENV_RUNS="$RUNS"
export SINGULARITYENV_BANDS="$BANDS" APPTAINERENV_BANDS="$BANDS"

FITS="${FITS:-}"
echo "opt-in fits and readings: ${FITS:-none}"
export SINGULARITYENV_FITS="$FITS" APPTAINERENV_FITS="$FITS"

cat << 'EOF' > run_inside.sh
#!/bin/bash
set -e
source /opt/myproject/.venv/bin/activate

DATA_DIR="/mnt/data/processed"

# RUNS -> store variants (the full fit of each; FITS adds its other fits).
VARIANTS=""
for RUN in ${RUNS:-tracks}; do
    case "$RUN" in
        separate)    VARIANTS+=" corrca_channel_joined_separate" ;;
        tracks)      VARIANTS+=" corrca_channel_joined_tracks" ;;
        placebo_fit) VARIANTS+=" corrca_channel_placebo_fit" ;;
        individual)  VARIANTS+=" corrca_channel_individual_conditions" ;;
        *) echo >&2 "unknown RUNS entry: $RUN"; exit 1 ;;
    esac
done

# Opt-in stores and readings (FITS); the full-montage raw-power store always.
FIT_FLAGS=()
SIGNALS=(full)
for F in ${FITS:-}; do
    case "$F" in
        log_power) FIT_FLAGS+=(--log_power); SIGNALS+=(swapped_filter) ;;
        roi_fit|non_roi_fit) FIT_FLAGS+=("--$F") ;;
        roi_masked) SIGNALS+=(roi_masked non_roi_masked) ;;
        *) echo >&2 "unknown FITS entry: $F"; exit 1 ;;
    esac
done

echo "=== raw weighted (PC1 + mean): every run at $(date) ==="
python /mnt/scripts/run_corrca_raw_weighted.py \
    --experiment assr \
    --variant $VARIANTS \
    --music_type ASSR \
    --bands ${BANDS:-broadband 30-50hz} \
    --conditions Placebo Psilocybin \
    --n_pca "${N_PCA:-5}" \
    --components 3 \
    "${FIT_FLAGS[@]}" \
    --store_dir "$DATA_DIR" \
    --wavelet_data_dir "$DATA_DIR" \
    --save_dir /mnt/plots
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
