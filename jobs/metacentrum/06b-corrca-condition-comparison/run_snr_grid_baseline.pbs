#!/bin/bash
#PBS -N PSILO_CORRCA_06B_SNR_BASELINE
#PBS -l walltime=2:00:00
#PBS -l select=1:ncpus=2:mem=100gb:scratch_local=100gb
#PBS -m ae
#PBS -j oe

# ===========================================================================
# run_snr_grid_baseline.pbs
#   The SNR grid and the stimulus-averaged TF maps on ANOTHER BASELINE. READ-ONLY.
#   Stage 06b; the default figures and files are not touched
#
# USAGE   (bash run_snr_grid_baseline.pbs --help prints this block)
#   qsub run_snr_grid_baseline.pbs
#       the tracks run at N_PCA=5, baseline -300 to -50 ms
#   qsub -v BASELINE=-0.25:-0.05,RUNS=separate run_snr_grid_baseline.pbs
#       another window and run
#   qsub -v TF_MAPS=0 run_snr_grid_baseline.pbs
#       the grid only (the cache read at 40 Hz, several times faster)
#   qsub -v STORE_BANDS="",SWAP_BANDS=1-30hz run_snr_grid_baseline.pbs
#       the broadband grid and one band-swap reading only
#
# PARAMETERS   (qsub -v NAME=value,NAME2="a b"; the defaults in brackets)
#   BASELINE       [-0.3:-0.05]  pre-stimulus window, seconds lo:hi (hi <= 0); 'default'
#                            = the whole pre-onset span, i.e. the fit jobs' own grid
#                            and maps redrawn into the usual directories (overwriting)
#   RUNS           [tracks]  which runs, any of: tracks (time-axis join),
#                            separate (subject-axis join), placebo_fit (separate,
#                            filters fitted on Placebo), individual (each condition
#                            alone)
#   N_PCA          [5]       the component count of the stores read
#   STORE_BANDS    [30-50hz] band stores whose own grid is also redone ("" = none;
#                            1-30hz has no 40 Hz bin)
#   SWAP_BANDS     [30-50hz 1-30hz]  band-swap readings of the broadband store ("" = none)
#   TF_MAPS        [1]       1: also the TF maps at every store frequency; 0: grid only
#   FITS           [none]    also read the runs' other fits, any of: log_power,
#                            roi_fit, non_roi_fit, roi_masked (as the fit jobs'
#                            FITS made them; see run_condition_tracks.pbs --help)
# END USAGE
#
# WHAT IT DOES
#
# scripts/run_corrca_snr_grid.py --baseline=<lo>:<hi> normalises every trial by
# that pre-stimulus window instead of the whole pre-onset span: its own mean
# subtracted, divided by the SD pooled over trials, and the ROI reference
# likewise. The trials are not stored (only their medians), so the cache is
# read again. Per run, with the fit jobs' grid settings (0 and +-5 Hz, windows
# 0-0.5 s and 0.2-0.5 s, contrast / discrimination / snr tests): (1) the
# store's own grid, broadband and each of STORE_BANDS; (2) the band-swap
# reading of the broadband store for each of SWAP_BANDS. A run whose full store
# is missing fails on its own; the job carries on and exits 1 at the end.
#
# OUTPUT   (into <fit dir>/baseline_<lo>_<hi>ms/, laid out like the fit's directory)
#   snr_grid/<selection>/<window>/*.png      the grid figures
#   condition_mean_tf_maps_onset.png         the stored sources, every component
#   roi_masked_*, non_roi_masked_*           with FITS roi_masked
#   swapped_filter_*, band_swapped_filter_<band>_*   CC 1-3
#   participants/*onset_*                    the same per participant
#   results/assr/assr_snr_grid_baseline_<lo>_<hi>ms__<variant>__<spectrum>__pca<N>*
#   results/assr/corrca_band_swap_snr_baseline_<lo>_<hi>ms__<variant>__<band>__pca<N>*
#
# RESOURCES
#   A cache pass at every frequency takes ~15 min per store at full length,
#   four passes per run by default (broadband, 30-50hz, two swaps): walltime 2
#   h covers one run; raise it for several RUNS or with FITS. Memory: one ~1 GB
#   store and per condition three (P, 5, 50, T) float32 projections (~2 GB
#   each), growing with N_PCA. numpy z-scoring is single-threaded; the
#   projections use BLAS.
# ===========================================================================

# --help: print the USAGE block above and exit, without submitting or running
# anything (bash <this job>.pbs --help).
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    sed -n '/^# USAGE/,/^# END USAGE/{/^# END USAGE/d;s/^# \{0,1\}//;p}' "$0"
    exit 0
fi

set -e

cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music_new.sif"

export TMPDIR=$SCRATCHDIR
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

N_PCA="${N_PCA:-5}"
BASELINE="${BASELINE:--0.3:-0.05}"
STORE_BANDS="${STORE_BANDS-30-50hz}"
RUNS="${RUNS:-tracks}"
TF_MAPS="${TF_MAPS:-1}"
SWAP_BANDS="${SWAP_BANDS-30-50hz 1-30hz}"
echo "PCA dimensions: $N_PCA, baseline: $BASELINE s, store bands: broadband" \
     "$STORE_BANDS, band swaps: $SWAP_BANDS, runs: $RUNS, TF maps: $TF_MAPS"

# The runner heredoc below is quoted, so these are read from the container
# environment at run time rather than substituted here.
for NAME in N_PCA BASELINE STORE_BANDS SWAP_BANDS RUNS TF_MAPS; do
  export "SINGULARITYENV_$NAME=${!NAME}" "APPTAINERENV_$NAME=${!NAME}"
done

FITS="${FITS:-}"
echo "opt-in fits and readings: ${FITS:-none}"
export SINGULARITYENV_FITS="$FITS" APPTAINERENV_FITS="$FITS"

cat << 'EOF' > run_inside.sh
#!/bin/bash
set -e
source /opt/myproject/.venv/bin/activate

DATA_DIR="/mnt/data/processed"

# RUNS -> store variants (the full fit of each; FITS adds its other fits).
VARIANTS=""
for RUN in ${RUNS:-tracks}; do
    case "$RUN" in
        separate)    VARIANTS+=" corrca_channel_joined_separate" ;;
        tracks)      VARIANTS+=" corrca_channel_joined_tracks" ;;
        placebo_fit) VARIANTS+=" corrca_channel_placebo_fit" ;;
        individual)  VARIANTS+=" corrca_channel_individual_conditions" ;;
        *) echo >&2 "unknown RUNS entry: $RUN"; exit 1 ;;
    esac
done

# Opt-in stores and readings (FITS); the full-montage raw-power store always.
FIT_FLAGS=()
SIGNALS=(full)
for F in ${FITS:-}; do
    case "$F" in
        log_power) FIT_FLAGS+=(--log_power); SIGNALS+=(swapped_filter) ;;
        roi_fit|non_roi_fit) FIT_FLAGS+=("--$F") ;;
        roi_masked) SIGNALS+=(roi_masked non_roi_masked) ;;
        *) echo >&2 "unknown FITS entry: $F"; exit 1 ;;
    esac
done
FAILED=0
TF_FLAG=()
[ "$TF_MAPS" = "1" ] && TF_FLAG=(--masked_tf_maps)
BASELINE_FLAG=()
[ "$BASELINE" != "default" ] && BASELINE_FLAG=(--baseline="$BASELINE")

grid() {
    python /mnt/scripts/run_corrca_snr_grid.py \
        --experiment assr \
        --music_type ASSR \
        --conditions Placebo Psilocybin \
        --n_pca "$N_PCA" \
        "${BASELINE_FLAG[@]}" \
        --halfwidths 0 5 \
        --stimulus_intervals 0:0.5 0.2:0.5 \
        --contrast_alternative greater \
        --snr_alternative less \
        --store_dir "$DATA_DIR" \
        --wavelet_data_dir "$DATA_DIR" \
        --results_dir /mnt/results/assr \
        --save_dir /mnt/plots \
        "${TF_FLAG[@]}" \
        "${FIT_FLAGS[@]}" \
        "$@" || {
        echo >&2 "FAILED: $*"
        FAILED=1
    }
}

for VARIANT in $VARIANTS; do
    echo "=== $VARIANT, broadband, baseline $BASELINE at $(date) ==="
    grid --variant "$VARIANT" \
        --signal_variants "${SIGNALS[@]}"
    for BAND in $STORE_BANDS; do
        echo "=== $VARIANT, $BAND, baseline $BASELINE at $(date) ==="
        grid --variant "$VARIANT" --band "$BAND" \
            --signal_variants "${SIGNALS[@]}"
    done
    for BAND in $SWAP_BANDS; do
        echo "=== $VARIANT, band swap $BAND, baseline $BASELINE at $(date) ==="
        grid --variant "$VARIANT" --swap_band "$BAND"
    done
done
exit "$FAILED"
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed (see FAILED lines above)"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
