#!/bin/bash
#PBS -N PSILO_CORRCA_TRACKS_06B_BAND
#PBS -l walltime=2:00:00
#PBS -l select=1:ncpus=4:mem=300gb:scratch_local=100gb
#PBS -m ae
#PBS -j oe

# ===========================================================================
# run_condition_tracks_gamma.pbs
#   CorrCA on the time-axis join (tracks), 30-50 Hz, then its SNR grid
#   Stage 06b. Band twins: run_condition_tracks{,_gamma,_1_30hz}.pbs
#
# USAGE   (bash run_condition_tracks_gamma.pbs --help prints this block)
#   qsub run_condition_tracks_gamma.pbs
#       the full fit (full montage, raw power) at N_PCA=5, then its SNR grid
#   qsub -v N_PCA=10 run_condition_tracks_gamma.pbs
#       another component count
#   qsub -v FITS="log_power roi_fit" run_condition_tracks_gamma.pbs
#       add the log-power and ROI fits
#   qsub -v FORCE_FIT=1 run_condition_tracks_gamma.pbs
#       refit although a store for this N_PCA exists (default: read it back)
#
# PARAMETERS   (qsub -v NAME=value,NAME2="a b"; the defaults in brackets)
#   N_PCA          [5]     components = dimension of the covariance subspace
#   FITS           [none]  extra fits and readings, any of:
#                    log_power    the log10-power twin of each selected fit ('_log');
#                                 in the grid also the swapped_filter rows
#                    roi_fit      a fit on the ASSR ROI electrodes alone ('_roi')
#                    non_roi_fit  a fit on every other electrode ('_non_roi')
#                    roi_masked   the full fit read through the ROI and through the
#                                 rest of the head (roi_masked_*, non_roi_masked_*)
#                  The default walltime (2:00:00) covers any FITS.
#   FORCE_FIT      [0]     1 refits each selected fit; 0 reads a stored one back
#   PARALLEL_FITS  [3]     fits run at once (a memory budget, see RESOURCES)
# END USAGE
#
# WHAT IT DOES
#
# 1. FIT, scripts/run_corrca_condition_tracks.py (the same code as
#    notebooks/06b-corrca-condition-comparison/corrca_channel_joined_tracks.ipynb).
#    Each matched participant is one subject whose Placebo track is followed by
#    their Psilocybin track, each z-scored on its own first (--zscore_mode
#    per_condition: an overall power difference is normalised away). ONE filter
#    per component over both tracks, so a component is the same spatial
#    combination in both conditions; the sources are split back into the two
#    segments for the per-condition ISC. One sign per component, from the
#    shared pattern against the ASSR electrode mask.
#
#    Fits, in this order, from the ONE loaded tensor: full, '_log', '_roi',
#    '_non_roi', '_log_roi', '_log_non_roi' (only the full one unless FITS adds
#    the others). An electrode cut is made BEFORE the z-scoring (ROI -> z-score
#    -> PCA -> CorrCA); log10 power (floored at the dtype's smallest normal
#    number) is taken BEFORE any z-scoring. N_PCA is the covariance subspace
#    dimension, i.e. the component count. A fit whose store for this N_PCA
#    exists is READ BACK (--skip_stored) and every figure is redrawn from it; a
#    store fitted on other data is refused. Each fit also writes its
#    leave-one-participant-out influence and the leave-subset-out refits the
#    grid's robustness rows read.
#
#    BAND: 30-50 Hz. The frequency axis is cut (--band_range 30 50) BEFORE the
#    fit, so the filter is chosen on gamma alone and the 40 Hz steady state is
#    not blended with the low-frequency onset response. Stored and drawn under
#    the band token '30-50hz' (plots under bands/, a '30-50hz_' file prefix),
#    beside the broadband run; the grid reads that store with --band 30-50hz.
#
# 2. SNR GRID, scripts/run_corrca_snr_grid.py (the same code as
#    corrca_component_analysis_joined_tracks.ipynb) on every stored fit, in the
#    fit order: the stage-06 trials, three ASSR references and test families
#    (contrast, discrimination, snr; exact Wilcoxon over participants,
#    uncorrected), at 40 Hz and 35-45 Hz, windows 0-0.5 s and 0.2-0.5 s. Reads
#    the stored sources ('full'); FITS roi_masked adds the roi_masked /
#    non_roi_masked rows and log_power the swapped_filter rows (the raw <-> log
#    twin's filters on this input; its CC 1-3 TF maps drawn into the fit's
#    directory). A '_non_roi' store has no ASSR electrode: only its full rows,
#    against ASSR-mask (full). The stored sources are unsplit; the grid slices
#    each condition's segment back out.
#
# OUTPUT
#   plots/06b-corrca-condition-comparison/JoinedTracks_ASSR/bands/
#       corrca_channel_joined_tracks[_log,_roi,...]/pca_<N>/
#           30-50hz_condition_mean_tf_maps*, 30-50hz_corrca_*, influence/, participants/
#           snr_grid/<selection>/<window>/*.png        (the SNR grid)
#   data/processed/assr/iva_results/JoinedTracks/
#       corrca_channel_joined_tracks[_log,...]__ASSR__30-50hz__pca<N>.npz (+ __subset_refits.npz)
#   results/assr/assr_snr_grid__corrca_channel_joined_tracks[_log,...]__bands__pca<N>*
#
# RESOURCES
#   mem=300gb and ncpus=4 cover every fit at PARALLEL_FITS=3, so FITS never
#   needs more memory; walltime=2:00:00 is sized for the default full fit and
#   covers any FITS.
#
# MEMORY (499 GB is the hard cap). The band is cut after loading, so the load is
# the broadband one (the joined broadband tensor, ~44 GB, stays beside the ~18 GB
# 30-50 Hz cut). Each running fit holds about three copies of its prepared input
# at its peak — a full-montage gamma fit ~55 GB — and --parallel_fits 3 lets three
# full-montage fits' worth run at once (cut fits count as their share of the
# channels: ROI ~0.2, non-ROI ~0.8), so ~230 GB. Check resources_used.mem after a
# run.
# ===========================================================================

# --help: print the USAGE block above and exit, without submitting or running
# anything (bash <this job>.pbs --help).
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    sed -n '/^# USAGE/,/^# END USAGE/{/^# END USAGE/d;s/^# \{0,1\}//;p}' "$0"
    exit 0
fi

set -e

cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music_new.sif"

export TMPDIR=$SCRATCHDIR
# Up to four fits run at once (--parallel_fits), one BLAS thread each: one per CPU.
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

N_PCA="${N_PCA:-5}"
FORCE_FIT="${FORCE_FIT:-0}"
echo "PCA dimensions: $N_PCA, force fit: $FORCE_FIT"

# The runner heredoc below is quoted, so these are read from the container
# environment at run time rather than substituted here.
export SINGULARITYENV_N_PCA="$N_PCA" APPTAINERENV_N_PCA="$N_PCA"
export SINGULARITYENV_FORCE_FIT="$FORCE_FIT" APPTAINERENV_FORCE_FIT="$FORCE_FIT"
FITS="${FITS:-}"
echo "opt-in fits and readings: ${FITS:-none}"
export SINGULARITYENV_FITS="$FITS" APPTAINERENV_FITS="$FITS"
PARALLEL_FITS="${PARALLEL_FITS:-3}"
echo "fits at once: $PARALLEL_FITS"
export SINGULARITYENV_PARALLEL_FITS="$PARALLEL_FITS" APPTAINERENV_PARALLEL_FITS="$PARALLEL_FITS"

cat << 'EOF' > run_inside.sh
#!/bin/bash
# A failed fit must not leave the grid reading a stale store.
set -e
source /opt/myproject/.venv/bin/activate

DATA_DIR="/mnt/data/processed"

# Opt-in fits and readings (FITS); the full montage on raw power always runs.
FIT_FLAGS=()
MASKED_FLAG=()
SIGNALS=(full)
for F in ${FITS:-}; do
    case "$F" in
        log_power) FIT_FLAGS+=(--log_power); SIGNALS+=(swapped_filter) ;;
        roi_fit|non_roi_fit) FIT_FLAGS+=("--$F") ;;
        roi_masked) MASKED_FLAG=(--roi_masked); SIGNALS+=(roi_masked non_roi_masked) ;;
        *) echo >&2 "unknown FITS entry: $F"; exit 1 ;;
    esac
done
MASKED_TF=()
if [ "${#SIGNALS[@]}" -gt 1 ]; then
    MASKED_TF=(--masked_tf_maps)
fi

SKIP_STORED=(--skip_stored)
if [ "${FORCE_FIT:-0}" = "1" ]; then
    SKIP_STORED=()
fi

echo "=== fit at $(date) ==="
python /mnt/scripts/run_corrca_condition_tracks.py \
    --experiment assr \
    --conditions Placebo Psilocybin \
    --n_pca "${N_PCA:-5}" \
    --gamma 0.0 \
    --band_range 30 50 \
    --zscore_mode per_condition \
    --wavelet_data_dir "$DATA_DIR" \
    --reuse_wavelets \
    --store_components \
    --store_dir "$DATA_DIR" \
    "${SKIP_STORED[@]}" \
    --save_dir /mnt/plots \
    --n_jobs -1 \
    --parallel_fits "${PARALLEL_FITS:-3}" \
    "${FIT_FLAGS[@]}" "${MASKED_FLAG[@]}"

echo "=== SNR grid at $(date) ==="
python /mnt/scripts/run_corrca_snr_grid.py \
    --experiment assr \
    --variant corrca_channel_joined_tracks \
    --music_type ASSR \
    --band 30-50hz \
    --conditions Placebo Psilocybin \
    --n_pca "${N_PCA:-5}" \
    --halfwidths 0 5 \
    --stimulus_intervals 0:0.5 0.2:0.5 \
    --signal_variants "${SIGNALS[@]}" \
    "${MASKED_TF[@]}" "${FIT_FLAGS[@]}" \
    --contrast_alternative greater \
    --snr_alternative less \
    --store_dir "$DATA_DIR" \
    --wavelet_data_dir "$DATA_DIR" \
    --results_dir /mnt/results/assr \
    --save_dir /mnt/plots
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
