#!/bin/bash
#PBS -N PSILO_STORE_WAVELETS
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=8:mem=120gb:scratch_local=100gb

#PBS -m ae
#PBS -j oe

set -e

# Ensure clean_scratch runs on exit, even on error
cleanup() {
echo "Running clean_scratch at $(date)"
clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music.sif"

export TMPDIR=$SCRATCHDIR

test -n "$SCRATCHDIR" || {
echo >&2 "SCRATCHDIR is not set!"
exit 1
}

cd "$DATADIR" || {
echo >&2 "Failed to enter DATADIR"
exit 1
}

cd "$SCRATCHDIR"

# Create the runner script for inside container
# Runs wavelet_power storage for all music types and both conditions.
# Each invocation computes and stores broadband + all per-band wavelets;
# filenames follow the convention: {condition}_{music}__wavelet_power__...npz
cat << 'EOF' > run_inside.sh
#!/bin/bash
source /opt/myproject/.venv/bin/activate

WAVELET_DIR="/mnt/data/processed/psilo_music/wavelets"

# ----- Placebo -----
# Broadband + low-frequency bands (delta, theta, alpha) — memory-intensive
python /mnt/scripts/run_analysis.py \
    --analysis wavelet_power \
    --condition Placebo \
    --music_type CLASSIC PSYTRANCE \
    --wavelet_bands delta theta alpha \
    --wavelet_data_dir "$WAVELET_DIR" \
    --n_jobs -1

# High-frequency bands (beta, gamma) — reuse broadband, add remaining bands
python /mnt/scripts/run_analysis.py \
    --analysis wavelet_power \
    --condition Placebo \
    --music_type CLASSIC PSYTRANCE \
    --wavelet_bands beta gamma \
    --skip_wavelet_broadband \
    --wavelet_data_dir "$WAVELET_DIR" \
    --reuse_wavelets \
    --n_jobs -1

# ----- Psilocybin -----
python /mnt/scripts/run_analysis.py \
    --analysis wavelet_power \
    --condition Psilocybin \
    --music_type CLASSIC PSYTRANCE \
    --wavelet_bands delta theta alpha \
    --wavelet_data_dir "$WAVELET_DIR" \
    --n_jobs -1

python /mnt/scripts/run_analysis.py \
    --analysis wavelet_power \
    --condition Psilocybin \
    --music_type CLASSIC PSYTRANCE \
    --wavelet_bands beta gamma \
    --skip_wavelet_broadband \
    --wavelet_data_dir "$WAVELET_DIR" \
    --reuse_wavelets \
    --n_jobs -1
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

# Bind your project directory as /mnt inside container
singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"
