#!/bin/bash
#PBS -N PSILO_IVA_CH_05
#PBS -l walltime=2:00:00
#PBS -l select=1:ncpus=8:mem=499gb:scratch_local=80gb
#PBS -m ae
#PBS -j oe

# ---------------------------------------------------------------------------
# Stage-05 IVA — channel independent dimension (spectro-temporal sources).
#
# Runs the same pipeline as
# notebooks/05-wavelet-iva-analysis/wavelet_iva_channel.ipynb
# on full data (no subject/channel/time subset). K = S subjects, IVA
# mixing = channels, samples = the joint time × frequency axis; per-subject
# PCA over channels → IVA-G. Each component is a shared-across-subjects
# spectro-temporal source (F, T) plus a per-subject channel topography (C,).
#
# Plots: component ranking, channel-PCA scree, temporal- and spectral-
# marginal ISC matrices + clusters, LOO-ISC bars for four axes
# (spectro-temporal, temporal, spectral, channel) + a by-axis summary,
# topomap mean/var of the channel patterns, the shared time × frequency
# source map (direct), source mean ± √variance along time and frequency,
# pair-space heatmaps (Time × Subject, Subject × Frequency,
# Subject × Channel), per-subject mean loadings.
#
# Marginals are kept SIGNED (RdBu_r). The spectral marginal (signed mean
# over time) is ~0 by construction because z-scoring zeroes each series'
# time-mean, so the spectral matrix / Subject × Frequency heatmap may look
# like noise — intentional, matching the notebook.
#
# Processes Placebo × {CLASSIC, PSYTRANCE} as two **separate Python
# invocations** inside this single PBS job — the interpreter exits between
# them, so all per-music-type state is fully released by the OS before the
# next music type starts. Peak memory stays bounded to one music type.
#
# Output:
#   plots/05-channel-wavelet-iva-analysis/Placebo_CLASSIC/
#       broadband/iva_channel/pca_100/*_top.png and *_bottom.png
#   plots/05-channel-wavelet-iva-analysis/Placebo_PSYTRANCE/
#       broadband/iva_channel/pca_100/*_top.png and *_bottom.png
#
# Components are ranked by the mean off-diagonal value of the per-component
# Sigma_N correlation matrix returned by iva_g (the IVA model's own estimate
# of how strongly the kth SCV couples across subjects); the top N_TOP and
# bottom N_BOTTOM are visualised separately so the bottom set serves as a
# noise / no-alignment contrast.
#
# NB: --n_pca reduces the CHANNEL axis here, so it must be <= the number of
# channels (≈195 after preprocessing). Reuses cached wavelet tensors from
# Stage-03 (run_wavelet_power.pbs).
# ---------------------------------------------------------------------------

set -e

cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music_new.sif"

export TMPDIR=$SCRATCHDIR

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

cat << 'EOF' > run_inside.sh
#!/bin/bash
source /opt/myproject/.venv/bin/activate

WAVELET_DIR="/mnt/data/processed/psilo_music/wavelets"

COMMON_ARGS=(
    --condition Placebo
    --experiment psilo_music
    --n_pca 15
    --n_top 10
    --n_bottom 5
    --random_state 42
    --iva_opt_approach newton
    --iva_max_iter 1024
    --wavelet_data_dir "$WAVELET_DIR"
    --reuse_wavelets
    --n_jobs -1
)

echo "=== CLASSIC at $(date) ==="
python /mnt/scripts/run_wavelet_iva_channel.py \
    --music_type CLASSIC \
    "${COMMON_ARGS[@]}"

echo "=== PSYTRANCE at $(date) ==="
python /mnt/scripts/run_wavelet_iva_channel.py \
     --music_type PSYTRANCE \
     "${COMMON_ARGS[@]}"
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
