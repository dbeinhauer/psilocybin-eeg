#!/bin/bash
#PBS -N PSILO_IVA_TIME_05
#PBS -l walltime=4:00:00
#PBS -l select=1:ncpus=8:mem=499gb:scratch_local=80gb
#PBS -m ae
#PBS -j oe

# ---------------------------------------------------------------------------
# Stage-05 IVA — time as the independent dimension.
#
# Runs the same pipeline as
# notebooks/05-wavelet-iva-analysis/wavelet_iva_time.ipynb
# on full data (no subject/channel/time subset). K = S subjects, IVA
# features = T (transposed compared to the frequency × channel sibling),
# samples = C × F; per-subject PCA reduces the T axis → IVA-G.
#
# WARNING: with T ≈ 91k samples this is the most memory-hungry IVA
# variant. The per-subject PCA's input matrix is (C*F=13650, T=91392),
# i.e. ~1.2 GB float64 per subject before reduction; PCA then projects
# down to (n_pca, T) which dominates downstream memory. If the job runs
# out, lower --n_pca, slice the time axis, or split subjects.
#
# Plots: same set as the frequency × channel sibling job — see
# run_frequency_channel.pbs header for the full list — but with the
# roles of scores and components swapped.
#
# Processes Placebo × {CLASSIC, PSYTRANCE} as two **separate Python
# invocations** inside this single PBS job — the interpreter exits
# between them, so all per-music-type state (data_4d, X_pca,
# iva_components, …) is fully released by the OS before the next
# music type starts. Peak memory stays bounded to one music type.
#
# Output:
#   plots/05-time-wavelet-iva-analysis/Placebo_CLASSIC/broadband/iva_time/*_top.png
#   plots/05-time-wavelet-iva-analysis/Placebo_CLASSIC/broadband/iva_time/*_bottom.png
#   plots/05-time-wavelet-iva-analysis/Placebo_PSYTRANCE/broadband/iva_time/*_top.png
#   plots/05-time-wavelet-iva-analysis/Placebo_PSYTRANCE/broadband/iva_time/*_bottom.png
#
# Components are ranked by the mean off-diagonal value of the per-component
# Sigma_N correlation matrix returned by iva_g (the IVA model's own
# estimate of how strongly the kth SCV couples across subjects); the top
# N_TOP and bottom N_BOTTOM are then visualised separately so the bottom
# set serves as a noise / no-alignment contrast.
#
# Reuses cached wavelet tensors from Stage-03 (run_wavelet_power.pbs).
# ---------------------------------------------------------------------------

set -e

cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music_new.sif"

export TMPDIR=$SCRATCHDIR

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

cat << 'EOF' > run_inside.sh
#!/bin/bash
source /opt/myproject/.venv/bin/activate

WAVELET_DIR="/mnt/data/processed/psilo_music/wavelets"

COMMON_ARGS=(
    --condition Placebo
    --n_pca 100
    --n_top 10
    --n_bottom 5
    --random_state 42
    --iva_opt_approach newton
    --iva_max_iter 1024
    --wavelet_data_dir "$WAVELET_DIR"
    --reuse_wavelets
    --n_jobs -1
)

echo "=== CLASSIC at $(date) ==="
python /mnt/scripts/run_wavelet_iva_time.py \
    --music_type CLASSIC \
    "${COMMON_ARGS[@]}"

echo "=== PSYTRANCE at $(date) ==="
python /mnt/scripts/run_wavelet_iva_time.py \
    --music_type PSYTRANCE \
    "${COMMON_ARGS[@]}"
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
