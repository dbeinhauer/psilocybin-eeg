#!/bin/bash
#PBS -N PSILO_WAVELET_ICA_04
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=4:mem=80gb:scratch_local=80gb
#PBS -m ae
#PBS -j oe

# ---------------------------------------------------------------------------
# Stage-04 wavelet-ICA / PCA analysis (broadband + per-band).
#
# Runs all four decomposition strategies (Super-Brain, Inter-Subject,
# Temporal, Inverted Super-Brain) on both broadband and five frequency
# bands (delta, theta, alpha, beta, gamma) for the Placebo condition on
# both music types.  Each approach is saved under its own stage directory:
#
#   plots/04-superbrain-wavelet-ica-analysis/
#   plots/04-intersubject-wavelet-ica-analysis/
#   plots/04-temporal-wavelet-ica-analysis/
#   plots/04-inverted-superbrain-wavelet-ica-analysis/
#   plots/04-wavelet-ica-cross-band-summary/
#
# Matches the notebooks under notebooks/04-wavelet-ica-analysis/ and
# reuses cached wavelet tensors from Stage-03 (run_wavelet_power.pbs).
# ---------------------------------------------------------------------------

set -e

cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music.sif"

export TMPDIR=$SCRATCHDIR

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

cat << 'EOF' > run_inside.sh
#!/bin/bash
source /opt/myproject/.venv/bin/activate

WAVELET_DIR="/mnt/data/processed/psilo_music/wavelets"

python /mnt/scripts/run_wavelet_ica.py \
    --condition Placebo \
    --music_type CLASSIC PSYTRANCE \
    --n_pca 20 \
    --n_ica 10 \
    --random_state 42 \
    --wavelet_data_dir "$WAVELET_DIR" \
    --reuse_wavelets \
    --n_jobs -1
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
