#!/bin/bash
#PBS -N ASSR_DATASET_PREPROCESSING
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=4:mem=100gb:scratch_local=100gb

#PBS -m ae
#PBS -j oe

# Full preprocessing of the ASSR dataset: coarse crop -> filtering -> bad channel
# interpolation -> ICA -> RAW_AFTER_ICA.
#
# Re-run this after changing the stimulus-marker calibration
# (config/participant_mappings/assr_time_shift.csv) or AssrEpoch.MARKER_ONSET_OFFSET_S.
# The stimulus-aware coarse crop trims around the *offset-adjusted* onsets, so
# recordings cropped under a different offset carry the wrong lead-in and shorten the
# pre-stimulus baseline for the whole group at the alignment stage.
#
# Afterwards, regenerate in this order:
#   1. run_stimulus_alignment.pbs                       -> RAW_CROPPED
#   2. ../03-wavelet-analysis/store_assr_wavelets.pbs   -> concatenated + wavelets
#
# Same resources as the psilo_music preprocessing job: the pipeline is per-recording
# and dominated by ICA, which does not scale past a few cores here.

set -e

# Ensure clean_scratch runs on exit, even on error
cleanup() {
echo "Running clean_scratch at $(date)"
clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music.sif"  # or .sandbox

export TMPDIR=$SCRATCHDIR

test -n "$SCRATCHDIR" || {
echo >&2 "SCRATCHDIR is not set!"
exit 1
}

cd "$DATADIR" || {
echo >&2 "Failed to enter DATADIR"
exit 1
}

cd "$SCRATCHDIR"

# Create the runner script for inside container
cat << 'EOF' > run_inside.sh
#!/bin/bash
source /opt/myproject/.venv/bin/activate
python /mnt/scripts/run_preprocessing.py \
--experiment assr \
--raw_processing \
--process_excluded_ic \
--plot_results \
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

# Bind your project directory as /mnt inside container
singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
