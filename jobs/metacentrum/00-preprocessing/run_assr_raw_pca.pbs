#!/bin/bash
#PBS -N ASSR_RAW_PCA_00
#PBS -l walltime=0:30:00
#PBS -l select=1:ncpus=8:mem=64gb:scratch_local=20gb
#PBS -m ae
#PBS -j oe

# ---------------------------------------------------------------------------
# Stage-00 whole-dataset ASSR raw-voltage channel-PCA reduction.
#
# Replicates notebooks/00-preprocessing/assr_raw_pca_analysis.ipynb for ALL
# subjects and ALL channels: the stimulus-locked (per fam+ onset) evoked voltage
# is reduced to a few spatial components per participant by collapsing the
# channel dimension with a PCA over channels. Each component's score is plotted
# as its time course and its loading as its scalp topography, per participant and
# averaged across participants.
#
# N_COMPONENTS (below) sets how many leading components are kept — all treated
# identically, so a later component can be compared against PC1 rather than
# assumed uninformative: PCA ranks components by explained channel variance in
# the evoked window, which is not the same thing as carrying the 40 Hz
# steady-state, so a slow onset deflection can own PC1 and push the ASSR into PC2
# or PC3. The job prints a comparison table (explained variance, topography
# consistency, 40 Hz SNR of the driven interval) scoring the components against
# each other. Override at submit time:
#     qsub -v N_COMPONENTS=5 run_assr_raw_pca.pbs
#
# Each channel is z-scored against the WHOLE recording before epoching (equal
# electrode influence -> correlation-PCA), then trial-averaged; the post-onset
# window length is the shortest inter-onset interval so no epoch overlaps the
# next stimulus. Polarity is aligned across participants independently per
# component (loadings matched to a common template, orientation anchored to Cz)
# so each component's topographies and time courses share one consistent sign.
#
# The concatenated raw array (~1 GB) is memory-mapped, so memory stays low; the
# wavelet cache is opened only to read its small channel-name member (the canonical
# channel order), never its multi-GB data stream. Runtime is dominated by the
# per-subject PCA, not IO.
#
# The job also writes an UNREDUCED (no-PCA) channel-space reference from the same
# trial averages — the test reference the component panels are checked against:
# per-participant butterfly + GFP, the group-mean evoked topography over time, and
# per-channel driven-RMS / 40 Hz-SNR topomaps. Nothing there needs polarity
# alignment (the evoked voltage has a physical sign), which is what makes it a
# reference FOR the alignment rather than another thing to diagnose. It reuses the
# trial averages already in memory, so it adds no data read. Disable with:
#     qsub -v UNREDUCED_REFERENCE=0 run_assr_raw_pca.pbs
#
# Requires (per condition), produced by the stimulus alignment + wavelet store:
#   data/processed/assr/concatenated/<Condition>_ASSR.npy
#   data/processed/assr/concatenated/<Condition>_ASSR.stimulus_onsets.npy
#   data/processed/assr/concatenated/<Condition>_ASSR.metadata.csv
#   data/processed/assr/wavelets/broadband/<Condition>_ASSR__wavelet_power__*.npz
# A condition whose inputs are absent (e.g. Psilocybin not yet generated) is
# skipped cleanly rather than failing the job.
#
# Output (one time-course + one topomap figure per component, the shared overlay
# figure, and the unreduced reference set):
#   plots/00-preprocessing/assr_raw_pca/<Condition>_ASSR/raw_pca_pc<N>_*.png
#   plots/00-preprocessing/assr_raw_pca/<Condition>_ASSR/raw_pca_timecourse_overlay.png
#   plots/00-preprocessing/assr_raw_pca/<Condition>_ASSR/raw_unreduced_*.png
# ---------------------------------------------------------------------------

set -e

# Ensure clean_scratch runs on exit, even on error
cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music_new.sif"

export TMPDIR=$SCRATCHDIR

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

# How many leading channel-PCA components to extract, plot and compare.
# Change here, or override per submission with: qsub -v N_COMPONENTS=5 ...
N_COMPONENTS="${N_COMPONENTS:-3}"
echo "Components: $N_COMPONENTS"

# Whether to also write the unreduced (no-PCA) channel-space reference figures.
# 1 = write them (default), 0 = skip. Override with: qsub -v UNREDUCED_REFERENCE=0 ...
UNREDUCED_REFERENCE="${UNREDUCED_REFERENCE:-1}"
echo "Unreduced reference: $UNREDUCED_REFERENCE"

# The runner heredoc below is quoted, so these are read from the container
# environment at run time rather than substituted here.
export SINGULARITYENV_N_COMPONENTS="$N_COMPONENTS"
export APPTAINERENV_N_COMPONENTS="$N_COMPONENTS"
export SINGULARITYENV_UNREDUCED_REFERENCE="$UNREDUCED_REFERENCE"
export APPTAINERENV_UNREDUCED_REFERENCE="$UNREDUCED_REFERENCE"

# Create the runner script for inside the container
cat << 'EOF' > run_inside.sh
#!/bin/bash
source /opt/myproject/.venv/bin/activate

N_COMPONENTS="${N_COMPONENTS:-3}"
UNREDUCED_REFERENCE="${UNREDUCED_REFERENCE:-1}"

# Left unquoted below on purpose: empty means "pass no flag at all".
REFERENCE_FLAG=""
if [ "$UNREDUCED_REFERENCE" = "0" ]; then
  REFERENCE_FLAG="--no_unreduced_reference"
fi

echo "=== Placebo at $(date) ==="
python /mnt/scripts/run_assr_raw_pca.py \
    --condition Placebo \
    --n_components "$N_COMPONENTS" \
    $REFERENCE_FLAG

# echo "=== Psilocybin at $(date) ==="
# python /mnt/scripts/run_assr_raw_pca.py \
#     --condition Psilocybin \
#     --n_components "$N_COMPONENTS" \
#     $REFERENCE_FLAG
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

# Bind the project directory as /mnt inside the container
singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
