#!/bin/bash
#PBS -N ASSR_WAVELET_PCA_00
#PBS -l walltime=0:30:00
#PBS -l select=1:ncpus=8:mem=64gb:scratch_local=100gb
#PBS -m ae
#PBS -j oe

# ---------------------------------------------------------------------------
# Stage-00 whole-dataset ASSR wavelet channel-PCA reduction.
#
# Replicates notebooks/00-preprocessing/assr_wavelet_pca_analysis.ipynb for ALL
# subjects and ALL channels: the stimulus-locked (per fam+ onset) wavelet power
# is reduced to a few time-frequency maps per participant by collapsing the
# channel dimension with a PCA over channels (one score map per component), and
# plotted per participant and averaged across participants.
#
# N_COMPONENTS (below) sets how many leading components are kept — all treated
# identically, so a later component can be compared against PC1 rather than
# assumed uninformative: PCA ranks components by explained channel variance over
# the whole TF plane, which is mostly low-frequency bins, so a broad onset
# response can own PC1 while the narrow 40 Hz steady-state lands in PC2 or PC3.
# The job prints a comparison table (explained variance, topography consistency,
# driven-minus-baseline contrast in the ASSR band and broadband) scoring the
# components against each other. Extra components add no IO — the single
# streaming pass over the cache dominates the walltime. Override at submit time:
#     qsub -v N_COMPONENTS=5 run_assr_wavelet_pca.pbs
#
# Each channel's per-frequency power is z-scored against the WHOLE recording
# before epoching (removes the 1/f tilt), then epoch-averaged; the post-onset
# window length is the shortest inter-onset interval so no epoch overlaps the
# next stimulus.
#
# Each component's channel loading is also plotted as a scalp topomap (per
# participant + group average), and the retained / discarded channel-variance
# split is printed: the TF maps show when and at which frequency a component is
# active, the topomap shows where it comes from, which is what tells you whether
# the channel reduction kept signal or isolated an artefact — everything
# orthogonal to those topographies is filtered out. Electrode positions come from
# one RAW_CROPPED recording header (preload=False, no sample data read).
#
# The wavelet cache (tens of GB, stored by jobs/metacentrum/03-wavelet-analysis/
# store_assr_wavelets.pbs) is read lazily in one sequential streaming pass — each
# channel block is decompressed once and immediately reduced, and each subject's
# channel stack is collapsed to its component maps before the next subject is
# read — so memory stays low; walltime is dominated by decompressing the cache
# once per condition.
#
# The job also writes an UNREDUCED (no-PCA) channel-space reference — the test
# reference the component panels are checked against: channel-mean TF maps,
# band-limited channel-mean time courses, and per-channel driven-minus-baseline
# topomaps (ASSR band and broadband). No polarity alignment is involved (power has a
# fixed sign convention), which is what makes it a reference FOR the alignment
# rather than another thing to diagnose. Its summaries are accumulated inside the
# SAME streaming pass, while each subject's channel stack is still in memory, so
# walltime, memory and IO are unchanged. Disable with:
#     qsub -v UNREDUCED_REFERENCE=0 run_assr_wavelet_pca.pbs
#
# Requires (per condition), produced by the stimulus alignment + wavelet store:
#   data/processed/assr/concatenated/<Condition>_ASSR.stimulus_onsets.npy
#   data/processed/assr/concatenated/<Condition>_ASSR.metadata.csv
#   data/processed/assr/wavelets/broadband/<Condition>_ASSR__wavelet_power__*.npz
#   data/processed/assr/<RAW_CROPPED recording>  (header only, for the montage)
# A condition whose inputs are absent (e.g. Psilocybin not yet generated) is
# skipped cleanly rather than failing the job.
#
# Output (one TF figure and one topomap figure per component, the group TF figure
# with one panel per component, and the unreduced reference set):
#   plots/00-preprocessing/assr_wavelet_pca/<Condition>_ASSR/wavelet_pca_pc<N>_tf_per_participant.png
#   plots/00-preprocessing/assr_wavelet_pca/<Condition>_ASSR/wavelet_pca_pc<N>_topomap_per_participant.png
#   plots/00-preprocessing/assr_wavelet_pca/<Condition>_ASSR/wavelet_pca_tf_group_average.png
#   plots/00-preprocessing/assr_wavelet_pca/<Condition>_ASSR/wavelet_unreduced_*.png
# ---------------------------------------------------------------------------

set -e

# Ensure clean_scratch runs on exit, even on error
cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music_new.sif"

export TMPDIR=$SCRATCHDIR

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

# How many leading channel-PCA components to extract, plot and compare.
# Change here, or override per submission with: qsub -v N_COMPONENTS=5 ...
N_COMPONENTS="${N_COMPONENTS:-3}"
echo "Components: $N_COMPONENTS"

# Whether to also write the unreduced (no-PCA) channel-space reference figures.
# 1 = write them (default), 0 = skip. Override with: qsub -v UNREDUCED_REFERENCE=0 ...
UNREDUCED_REFERENCE="${UNREDUCED_REFERENCE:-1}"
echo "Unreduced reference: $UNREDUCED_REFERENCE"

# The runner heredoc below is quoted, so these are read from the container
# environment at run time rather than substituted here.
export SINGULARITYENV_N_COMPONENTS="$N_COMPONENTS"
export APPTAINERENV_N_COMPONENTS="$N_COMPONENTS"
export SINGULARITYENV_UNREDUCED_REFERENCE="$UNREDUCED_REFERENCE"
export APPTAINERENV_UNREDUCED_REFERENCE="$UNREDUCED_REFERENCE"

# Create the runner script for inside the container
cat << 'EOF' > run_inside.sh
#!/bin/bash
source /opt/myproject/.venv/bin/activate

N_COMPONENTS="${N_COMPONENTS:-3}"
UNREDUCED_REFERENCE="${UNREDUCED_REFERENCE:-1}"

# Left unquoted below on purpose: empty means "pass no flag at all".
REFERENCE_FLAG=""
if [ "$UNREDUCED_REFERENCE" = "0" ]; then
  REFERENCE_FLAG="--no_unreduced_reference"
fi

echo "=== Placebo at $(date) ==="
python /mnt/scripts/run_assr_wavelet_pca.py \
    --condition Placebo \
    --n_components "$N_COMPONENTS" \
    $REFERENCE_FLAG

# echo "=== Psilocybin at $(date) ==="
# python /mnt/scripts/run_assr_wavelet_pca.py \
#     --condition Psilocybin \
#     --n_components "$N_COMPONENTS" \
#     $REFERENCE_FLAG
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

# Bind the project directory as /mnt inside the container
singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
