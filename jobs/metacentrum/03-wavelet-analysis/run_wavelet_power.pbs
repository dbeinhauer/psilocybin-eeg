#!/bin/bash
#PBS -N PSILO_WAVELET_POWER_03
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=8:mem=300gb:scratch_local=100gb
#PBS -m ae
#PBS -j oe

# ---------------------------------------------------------------------------
# Wavelet-power analysis (store + broadband & per-band ISC / mean-variance).
#
# Matches the notebook  notebooks/03-wavelet-analysis/wavelet_power_exploration.ipynb
# and runs the full analysis pipeline for Placebo condition, both music types.
# ---------------------------------------------------------------------------

set -e

cleanup() {
  echo "Running clean_scratch at $(date)"
  clean_scratch
}
trap cleanup EXIT

echo "Task started at $(date)"

PROJECT_NAME="psilocybin-eeg"
SERVER_LOCATION="praha1"
DATADIR="/storage/$SERVER_LOCATION/home/$USER/$PROJECT_NAME"
SIF_IMAGE="/storage/$SERVER_LOCATION/home/$USER/singularity-images/psilo_music.sif"

export TMPDIR=$SCRATCHDIR

test -n "$SCRATCHDIR" || {
  echo >&2 "SCRATCHDIR is not set!"
  exit 1
}

cd "$DATADIR" || {
  echo >&2 "Failed to enter DATADIR"
  exit 1
}

cd "$SCRATCHDIR"

cat << 'EOF' > run_inside.sh
#!/bin/bash
source /opt/myproject/.venv/bin/activate

WAVELET_DIR="/mnt/data/processed"

# --- Pass 1: low-freq bands + broadband ---
# Use --reuse_wavelets so that a restart of pass 1 (e.g. after a transient
# failure) picks up any wavelets that were already persisted to $WAVELET_DIR
# instead of recomputing them from scratch.
# To restrict to specific music types, add:  --music_type CLASSIC PSYTRANCE
# (omitted -> defaults to all music types for the experiment)
python /mnt/scripts/run_analysis.py \
    --analysis wavelet_power \
    --experiment psilo_music \
    --condition Placebo \
    --wavelet_bands alpha \
    --wavelet_data_dir "$WAVELET_DIR" \
    --reuse_wavelets \
    --n_jobs -1

# --- Pass 2: high-freq bands (reuse broadband) ---
# To restrict to specific music types, add:  --music_type CLASSIC PSYTRANCE
# (omitted -> defaults to all music types for the experiment)
# python /mnt/scripts/run_analysis.py \
#     --analysis wavelet_power \
#     --experiment psilo_music \
#     --condition Placebo \
#     --wavelet_bands beta gamma \
#     --skip_wavelet_broadband \
#     --wavelet_data_dir "$WAVELET_DIR" \
#     --reuse_wavelets \
#     --n_jobs -1
EOF

chmod +x run_inside.sh

echo "Running inside Singularity at $(date)"

singularity exec --nv -B "$DATADIR":/mnt "$SIF_IMAGE" bash run_inside.sh || {
    echo >&2 "Python script failed"
    exit 1
}

echo "Task finished at $(date)"

clean_scratch
